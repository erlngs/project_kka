---
import PublicLayout from "../layouts/PublicLayout.astro";
import { prisma } from "../lib/prisma";

export const prerender = false;

const articles = await prisma.article.findMany({
  where: { publishedAt: { not: null } },
  orderBy: { publishedAt: "desc" },
});

const pageInfo = await prisma.page.findUnique({ where: { slug: "blog" } });

const placeholder = "https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&q=80";

const categories = [...new Set(articles.map((a) => a.category).filter(Boolean))] as string[];

function formatDate(d: Date) {
  return new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "long", year: "numeric" }).format(d);
}

function excerptText(a: (typeof articles)[number], len = 130) {
  const text = a.excerpt || a.content;
  return text.length > len ? text.slice(0, len).trim() + "…" : text;
}
---

<PublicLayout title="Artikel & Informasi" description={pageInfo?.metaDescription ?? pageInfo?.heroSubtitle}>
  <section class="relative h-[420px] md:h-[520px] flex items-center justify-center text-center overflow-hidden bg-neutral-800">
    {pageInfo?.heroImageUrl ? (
      <>
        <img src={pageInfo.heroImageUrl} alt="Artikel" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/70"></div>
      </>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-primary to-blue-800"></div>
    )}
    <div class="relative z-10 max-w-3xl px-6 text-white">
      <span class="inline-block bg-secondary/20 text-secondary text-xs font-semibold px-3 py-1 rounded-full mb-4 uppercase">Info & Update</span>
      <h1 class="font-heading text-3xl md:text-5xl font-bold mb-4 leading-tight">
        {pageInfo?.title ?? "Artikel & Informasi Terbaru"}
      </h1>
      <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
        {pageInfo?.heroSubtitle ?? "Panduan pendaftaran, tips belajar, dan berita resmi terbaru dari KKA Radar Kediri."}
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="bg-neutral-white rounded-2xl shadow-sm p-6 mb-10">
      <div class="relative mb-4">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="absolute left-4 top-1/2 -translate-y-1/2 text-neutral-dark/40">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Cari judul artikel atau topik..."
          class="w-full pl-11 pr-4 py-3 bg-neutral-gray rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>
      <div class="flex flex-wrap gap-2" id="filter-buttons">
        <button type="button" data-cat="all" class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-primary text-neutral-white">
          Semua
        </button>
        {categories.map((cat) => (
          <button type="button" data-cat={cat} class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-neutral-gray text-neutral-dark/70 hover:bg-neutral-200">
            {cat}
          </button>
        ))}
      </div>
    </div>

    {articles.length === 0 ? (
      <p class="text-center text-neutral-dark/65 py-10">Belum ada artikel yang dipublish.</p>
    ) : (
      <div id="article-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="article-card group block rounded-xl overflow-hidden bg-neutral-white shadow-sm hover:shadow-md transition-shadow"
            data-title={post.title.toLowerCase()}
            data-category={post.category ?? ""}
          >
            <div class="h-44 overflow-hidden">
              <img
                src={post.thumbnail ?? placeholder}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-neutral-dark/40">
                  <circle cx="12" cy="12" r="10" />
                  <path stroke-linecap="round" d="M12 6v6l4 2" />
                </svg>
                <span class="text-xs text-neutral-dark/50">{post.author ?? "Admin KKA"}</span>
                <span class="text-neutral-dark/30 text-xs">•</span>
                <span class="text-xs text-neutral-dark/40">{post.publishedAt && formatDate(post.publishedAt)}</span>
              </div>
              <h3 class="font-heading font-semibold text-neutral-dark leading-snug mb-2 group-hover:text-primary transition-colors">
                {post.title}
              </h3>
              <p class="text-sm text-neutral-dark/70 leading-relaxed mb-3">{excerptText(post)}</p>
              <span class="text-primary text-sm font-medium inline-flex items-center gap-1">
                Baca Selengkapnya
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    )}

    <p id="no-result" class="hidden text-center text-neutral-dark/65 py-10">Tidak ada artikel yang cocok dengan pencarian.</p>
  </section>
</PublicLayout>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const filterButtons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".article-card");
  const noResult = document.getElementById("no-result");

  let activeCategory = "all";

  function applyFilter() {
    const keyword = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchTitle = card.dataset.title?.includes(keyword);
      const matchCategory = activeCategory === "all" || card.dataset.category === activeCategory;
      const show = matchTitle && matchCategory;
      card.style.display = show ? "" : "none";
      if (show) visibleCount++;
    });

    noResult?.classList.toggle("hidden", visibleCount > 0);
  }

  searchInput?.addEventListener("input", applyFilter);

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = (btn as HTMLElement).dataset.cat || "all";
      filterButtons.forEach((b) => {
        b.classList.remove("bg-primary", "text-neutral-white");
        b.classList.add("bg-neutral-gray", "text-neutral-dark/70");
      });
      btn.classList.add("bg-primary", "text-neutral-white");
      btn.classList.remove("bg-neutral-gray", "text-neutral-dark/70");
      applyFilter();
    });
  });
</script>