---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { prisma } from "../../../lib/prisma";

export const prerender = false;

const gelombangList = await prisma.gelombang.findMany({
  include: { biaya: true },
  orderBy: { tanggalMulai: "asc" },
});

function getHarga(biaya: any[], jenjang: string) {
  return biaya.find((b) => b.jenjang === jenjang)?.harga ?? 0;
}

function formatRupiah(n: number) {
  return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(n);
}
---

<AdminLayout title="Gelombang & Biaya">
  <div class="flex justify-between items-center mb-5">
    <p class="text-sm text-neutral-dark/60">Kelola gelombang pendaftaran dan biaya per jenjang.</p>
    <button id="btn-add" class="bg-primary text-neutral-white text-sm font-medium px-4 py-2.5 rounded-lg hover:opacity-90">
      + Tambah Gelombang
    </button>
  </div>

  <div class="bg-neutral-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-neutral-dark/50 border-b border-neutral-gray">
          <th class="px-5 py-3 font-medium">Gelombang</th>
          <th class="px-5 py-3 font-medium">Periode</th>
          <th class="px-5 py-3 font-medium">SD/MI</th>
          <th class="px-5 py-3 font-medium">SMP/MTs</th>
          <th class="px-5 py-3 font-medium">SMA/MA/SMK</th>
          <th class="px-5 py-3 font-medium">Status</th>
          <th class="px-5 py-3 font-medium text-right">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {gelombangList.map((g) => (
          <tr class="border-b border-neutral-gray last:border-0">
            <td class="px-5 py-3 text-neutral-dark">{g.nama}</td>
            <td class="px-5 py-3 text-neutral-dark/70">
              {new Date(g.tanggalMulai).toLocaleDateString("id-ID")} - {new Date(g.tanggalSelesai).toLocaleDateString("id-ID")}
            </td>
            <td class="px-5 py-3 text-neutral-dark/70">{formatRupiah(getHarga(g.biaya, "SD_MI"))}</td>
            <td class="px-5 py-3 text-neutral-dark/70">{formatRupiah(getHarga(g.biaya, "SMP_MTS"))}</td>
            <td class="px-5 py-3 text-neutral-dark/70">{formatRupiah(getHarga(g.biaya, "SMA_MA_SMK"))}</td>
            <td class="px-5 py-3">
              <span class={`px-2.5 py-1 rounded-full text-xs font-medium ${g.isActive ? "bg-emerald-100 text-emerald-700" : "bg-neutral-200 text-neutral-dark/60"}`}>
                {g.isActive ? "Aktif" : "Nonaktif"}
              </span>
            </td>
            <td class="px-5 py-3 text-right">
              <button
                class="btn-edit text-primary text-xs font-medium mr-3"
                data-id={g.id}
                data-nama={g.nama}
                data-mulai={new Date(g.tanggalMulai).toISOString().split("T")[0]}
                data-selesai={new Date(g.tanggalSelesai).toISOString().split("T")[0]}
                data-active={String(g.isActive)}
                data-sd={getHarga(g.biaya, "SD_MI")}
                data-smp={getHarga(g.biaya, "SMP_MTS")}
                data-sma={getHarga(g.biaya, "SMA_MA_SMK")}
              >Edit</button>
              <button class="btn-delete text-red-500 text-xs font-medium" data-id={g.id}>Hapus</button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    {gelombangList.length === 0 && (
      <p class="text-sm text-neutral-dark/50 px-5 py-8 text-center">Belum ada gelombang.</p>
    )}
  </div>

  <div id="modal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
    <div class="bg-neutral-white rounded-xl w-full max-w-md p-6 max-h-[90vh] overflow-y-auto">
      <h2 id="modal-title" class="font-heading font-semibold text-lg text-neutral-dark mb-4">Tambah Gelombang</h2>
      <form id="form-gelombang" class="flex flex-col gap-3">
        <input type="hidden" id="f-id" />
        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Nama Gelombang</label>
          <input id="f-nama" required placeholder="Gelombang I" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Tanggal Mulai</label>
            <input id="f-mulai" type="date" required class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Tanggal Selesai</label>
            <input id="f-selesai" type="date" required class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Biaya SD/MI</label>
          <input id="f-sd" type="number" placeholder="50000" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Biaya SMP/MTs</label>
          <input id="f-smp" type="number" placeholder="60000" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Biaya SMA/MA/SMK</label>
          <input id="f-sma" type="number" placeholder="70000" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" />
        </div>
        <label class="flex items-center gap-2 text-sm text-neutral-dark">
          <input id="f-active" type="checkbox" checked />
          Aktif
        </label>

        <div id="form-error" class="hidden bg-red-50 text-red-600 text-sm rounded-lg px-3 py-2"></div>

        <div class="flex justify-end gap-2 mt-2">
          <button type="button" id="btn-cancel" class="px-4 py-2 text-sm text-neutral-dark/60 hover:bg-neutral-gray rounded-lg">Batal</button>
          <button type="submit" class="px-4 py-2 text-sm bg-primary text-neutral-white rounded-lg hover:opacity-90">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const modal = document.getElementById("modal") as HTMLDivElement;
  const modalTitle = document.getElementById("modal-title") as HTMLHeadingElement;
  const form = document.getElementById("form-gelombang") as HTMLFormElement;
  const errorBox = document.getElementById("form-error") as HTMLDivElement;

  const fId = document.getElementById("f-id") as HTMLInputElement;
  const fNama = document.getElementById("f-nama") as HTMLInputElement;
  const fMulai = document.getElementById("f-mulai") as HTMLInputElement;
  const fSelesai = document.getElementById("f-selesai") as HTMLInputElement;
  const fSd = document.getElementById("f-sd") as HTMLInputElement;
  const fSmp = document.getElementById("f-smp") as HTMLInputElement;
  const fSma = document.getElementById("f-sma") as HTMLInputElement;
  const fActive = document.getElementById("f-active") as HTMLInputElement;

  function openModal(isEdit = false) {
    errorBox.classList.add("hidden");
    modalTitle.textContent = isEdit ? "Edit Gelombang" : "Tambah Gelombang";
    modal.classList.remove("hidden");
  }

  document.getElementById("btn-add")?.addEventListener("click", () => {
    fId.value = "";
    fNama.value = "";
    fMulai.value = "";
    fSelesai.value = "";
    fSd.value = "";
    fSmp.value = "";
    fSma.value = "";
    fActive.checked = true;
    openModal(false);
  });

  document.getElementById("btn-cancel")?.addEventListener("click", () => modal.classList.add("hidden"));

  document.querySelectorAll(".btn-edit").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = btn as HTMLButtonElement;
      fId.value = el.dataset.id || "";
      fNama.value = el.dataset.nama || "";
      fMulai.value = el.dataset.mulai || "";
      fSelesai.value = el.dataset.selesai || "";
      fSd.value = el.dataset.sd || "0";
      fSmp.value = el.dataset.smp || "0";
      fSma.value = el.dataset.sma || "0";
      fActive.checked = el.dataset.active === "true";
      openModal(true);
    });
  });

  document.querySelectorAll(".btn-delete").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Yakin hapus gelombang ini?")) return;
      const id = (btn as HTMLButtonElement).dataset.id;
      const res = await fetch(`/api/admin/gelombang/${id}`, { method: "DELETE" });
      if (res.ok) location.reload();
    });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");

    const payload = {
      nama: fNama.value,
      tanggalMulai: fMulai.value,
      tanggalSelesai: fSelesai.value,
      hargaSd: Number(fSd.value) || 0,
      hargaSmp: Number(fSmp.value) || 0,
      hargaSma: Number(fSma.value) || 0,
      isActive: fActive.checked,
    };

    const isEdit = !!fId.value;
    const url = isEdit ? `/api/admin/gelombang/${fId.value}` : "/api/admin/gelombang";
    const method = isEdit ? "PUT" : "POST";

    try {
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const data = await res.json();
        errorBox.textContent = data.message || "Gagal menyimpan data";
        errorBox.classList.remove("hidden");
        return;
      }
      location.reload();
    } catch {
      errorBox.textContent = "Terjadi kesalahan, coba lagi.";
      errorBox.classList.remove("hidden");
    }
  });
</script>