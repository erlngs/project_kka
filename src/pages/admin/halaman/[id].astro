---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { prisma } from "../../../lib/prisma";

export const prerender = false;

const { id } = Astro.params;
const page = await prisma.page.findUnique({
  where: { id },
  include: { blocks: { orderBy: { orderIndex: "asc" } } },
});

if (!page) return Astro.redirect("/admin/halaman");
---

<AdminLayout title={`Kelola: ${page.title}`}>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" is:inline />

  <div class="flex justify-between items-center mb-5">
    <p class="text-sm text-neutral-dark/60">Atur isi halaman <b>{page.title}</b> — tambah, edit, hapus, atur urutan blok.</p>
    <button id="btn-add-block" class="bg-primary text-neutral-white text-sm font-medium px-4 py-2.5 rounded-lg hover:opacity-90">
      + Tambah Blok
    </button>
  </div>

  <div id="block-list" class="flex flex-col gap-3">
    {page.blocks.map((b, i) => (
      <div class="bg-neutral-white rounded-xl shadow-sm p-4 flex items-start justify-between gap-4" data-id={b.id}>
        <div class="flex-1">
          <span class="inline-block text-xs font-semibold uppercase text-primary bg-primary/10 rounded-full px-2 py-0.5 mb-2">
            {b.blockType}
          </span>
          <pre class="text-xs text-neutral-dark/70 whitespace-pre-wrap">{JSON.stringify(b.content, null, 2)}</pre>
        </div>
        <div class="flex flex-col gap-1 shrink-0">
          <button class="btn-move text-neutral-dark/50 hover:text-primary text-xs" data-id={b.id} data-dir="up" disabled={i === 0}>▲ Naik</button>
          <button class="btn-move text-neutral-dark/50 hover:text-primary text-xs" data-id={b.id} data-dir="down" disabled={i === page.blocks.length - 1}>▼ Turun</button>
          <button
            class="btn-edit-block text-primary text-xs"
            data-id={b.id}
            data-type={b.blockType}
            data-content={JSON.stringify(b.content)}
          >Edit</button>
          <button class="btn-delete-block text-red-500 text-xs" data-id={b.id}>Hapus</button>
        </div>
      </div>
    ))}
    {page.blocks.length === 0 && (
      <p class="text-sm text-neutral-dark/50 text-center py-10 bg-neutral-white rounded-xl">Belum ada blok konten. Klik "+ Tambah Blok".</p>
    )}
  </div>

  <!-- Modal -->
  <div id="modal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
    <div class="bg-neutral-white rounded-xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto">
      <h2 id="modal-title" class="font-heading font-semibold text-lg text-neutral-dark mb-4">Tambah Blok</h2>
      <form id="form-block" class="flex flex-col gap-3">
        <input type="hidden" id="f-block-id" />
        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Tipe Blok</label>
          <select id="f-type" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
            <option value="heading">Heading</option>
            <option value="paragraph">Paragraph</option>
            <option value="image">Image</option>
            <option value="gallery">Gallery</option>
            <option value="testimonial">Testimonial</option>
            <option value="cta_button">CTA Button</option>
            <option value="cards">Cards (Visi Misi, dll)</option>
          </select>
        </div>

        <div id="fields-heading" class="field-group flex flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Teks Heading</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="text" />
          </div>
        </div>

        <div id="fields-paragraph" class="field-group hidden flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Isi Paragraf</label>
            <textarea rows="4" class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="text"></textarea>
          </div>
        </div>

        <div id="fields-image" class="field-group hidden flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Upload Gambar</label>
            <input type="file" id="f-image-file" accept="image/*" class="w-full text-sm" />
            <input type="hidden" class="f-input" data-key="image_url" id="f-image-url-hidden" />
            <img id="preview-image" class="mt-2 rounded-lg max-h-40 hidden" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Alt Text</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="alt" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Caption</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="caption" />
          </div>
        </div>

        <div id="fields-gallery" class="field-group hidden flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">URL Gambar (pisah pakai koma)</label>
            <textarea rows="3" class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="images" placeholder="url1.jpg, url2.jpg, url3.jpg"></textarea>
          </div>
        </div>

        <div id="fields-testimonial" class="field-group hidden flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Nama</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="name" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Asal Sekolah / Peran</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="role" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Pesan</label>
            <textarea rows="3" class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="message"></textarea>
          </div>
        </div>

        <div id="fields-cta_button" class="field-group hidden flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Label Tombol</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="label" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">URL Tujuan</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="url" />
          </div>
        </div>

        <div id="fields-cards" class="field-group hidden flex-col gap-3">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Label Kecil (Eyebrow)</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="eyebrow" placeholder="KKA 2026 JAWA POS RADAR KEDIRI" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Judul Section</label>
            <input class="f-input w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" data-key="title" placeholder="Visi, Misi & Tujuan" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Daftar Card</label>
            <div id="cards-items" class="flex flex-col gap-3 mt-2"></div>
            <button type="button" id="btn-add-card-item" class="mt-2 text-sm text-primary font-medium">+ Tambah Card</button>
          </div>
        </div>

        <div id="form-error" class="hidden bg-red-50 text-red-600 text-sm rounded-lg px-3 py-2"></div>

        <div class="flex justify-end gap-2 mt-2">
          <button type="button" id="btn-cancel" class="px-4 py-2 text-sm text-neutral-dark/60 hover:bg-neutral-gray rounded-lg">Batal</button>
          <button type="submit" class="px-4 py-2 text-sm bg-primary text-neutral-white rounded-lg hover:opacity-90">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js" is:inline></script>

<script define:vars={{ pageId: page.id }}>
  const modal = document.getElementById("modal");
  const modalTitle = document.getElementById("modal-title");
  const form = document.getElementById("form-block");
  const errorBox = document.getElementById("form-error");
  const typeSelect = document.getElementById("f-type");
  const blockIdInput = document.getElementById("f-block-id");
  const cardsItemsContainer = document.getElementById("cards-items");

  function showFieldsFor(type) {
    document.querySelectorAll(".field-group").forEach((el) => el.classList.add("hidden"));
    document.getElementById(`fields-${type}`)?.classList.remove("hidden");
  }

  function clearFields() {
    document.querySelectorAll(".f-input").forEach((el) => (el.value = ""));
    document.getElementById("preview-image")?.classList.add("hidden");
    cardsItemsContainer.innerHTML = "";
  }

  // ---- Card item (dengan Quill rich text untuk deskripsi) ----
  function createCardItemRow(item = {}) {
    const div = document.createElement("div");
    div.className = "card-item border border-neutral-200 rounded-lg p-3 flex flex-col gap-2 relative";
    div.innerHTML = `
      <button type="button" class="btn-remove-item absolute top-2 right-2 text-red-500 text-xs z-10">✕</button>
      <div>
        <label class="block text-xs font-medium text-neutral-dark mb-1">Icon</label>
        <select class="f-item-input w-full px-2 py-1.5 border border-neutral-200 rounded text-sm" data-key="icon">
          <option value="">Tanpa Icon</option>
          <option value="lightbulb">💡 Lightbulb</option>
          <option value="target">🎯 Target</option>
          <option value="star">⭐ Star</option>
          <option value="shield">🛡 Shield</option>
          <option value="users">👥 Users</option>
          <option value="check">✅ Check</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-dark mb-1">Judul Card</label>
        <input class="f-item-input w-full px-2 py-1.5 border border-neutral-200 rounded text-sm" data-key="title" />
      </div>
      <div>
        <label class="block text-xs font-medium text-neutral-dark mb-1">Deskripsi</label>
        <div class="quill-editor-container bg-white rounded border border-neutral-200"></div>
      </div>
    `;

    div.querySelector('[data-key="icon"]').value = item.icon || "";
    div.querySelector('[data-key="title"]').value = item.title || "";
    div.querySelector(".btn-remove-item").addEventListener("click", () => {
      div._quill = null;
      div.remove();
    });

    // Append dulu ke container supaya Quill bisa attach dengan benar
    cardsItemsContainer.appendChild(div);

    const editorContainer = div.querySelector(".quill-editor-container");
    const quill = new Quill(editorContainer, {
      theme: "snow",
      modules: {
  toolbar: [
    ["bold", "italic", "underline"],
    [{ list: "ordered" }, { list: "bullet" }],
    [{ align: [] }],
    [{ color: [] }],
    [{ size: ["small", false, "large", "huge"] }],
  ],
},
    });

    if (item.description) {
      quill.clipboard.dangerouslyPasteHTML(item.description);
    }

    div._quill = quill;

    return div;
  }

  document.getElementById("btn-add-card-item").addEventListener("click", () => {
    createCardItemRow();
  });

  typeSelect.addEventListener("change", (e) => showFieldsFor(e.target.value));

  document.getElementById("btn-add-block").addEventListener("click", () => {
    blockIdInput.value = "";
    typeSelect.value = "heading";
    clearFields();
    showFieldsFor("heading");
    modalTitle.textContent = "Tambah Blok";
    modal.classList.remove("hidden");
  });

  document.getElementById("btn-cancel").addEventListener("click", () => {
    modal.classList.add("hidden");
  });

  document.querySelectorAll(".btn-edit-block").forEach((btn) => {
    btn.addEventListener("click", () => {
      const type = btn.dataset.type;
      const content = JSON.parse(btn.dataset.content);
      blockIdInput.value = btn.dataset.id;
      typeSelect.value = type;
      clearFields();
      showFieldsFor(type);

      document.querySelectorAll(`#fields-${type} .f-input`).forEach((input) => {
        const key = input.dataset.key;
        input.value = key === "images" ? (content.images || []).map((i) => i.url).join(", ") : (content[key] ?? "");
      });

      if (type === "image" && content.image_url) {
        const preview = document.getElementById("preview-image");
        preview.src = content.image_url;
        preview.classList.remove("hidden");
      }

      if (type === "cards") {
        cardsItemsContainer.innerHTML = "";
        (content.items || []).forEach((item) => createCardItemRow(item));
      }

      modalTitle.textContent = "Edit Blok";
      modal.classList.remove("hidden");
    });
  });

  document.querySelectorAll(".btn-delete-block").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!confirm("Yakin hapus blok ini?")) return;
      const res = await fetch(`/api/admin/halaman/${pageId}/blocks/${btn.dataset.id}`, { method: "DELETE" });
      if (res.ok) location.reload();
    });
  });

  document.querySelectorAll(".btn-move").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const res = await fetch(`/api/admin/halaman/${pageId}/blocks/${btn.dataset.id}/move`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ direction: btn.dataset.dir }),
      });
      if (res.ok) location.reload();
    });
  });

  document.getElementById("f-image-file")?.addEventListener("change", async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const fd = new FormData();
    fd.append("file", file);

    const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
    const data = await res.json();

    if (data.url) {
      document.getElementById("f-image-url-hidden").value = data.url;
      const preview = document.getElementById("preview-image");
      preview.src = data.url;
      preview.classList.remove("hidden");
    } else {
      alert("Gagal upload gambar: " + (data.message || "Unknown error"));
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");

    const type = typeSelect.value;
    const content = {};

    document.querySelectorAll(`#fields-${type} .f-input`).forEach((input) => {
      const key = input.dataset.key;
      if (key === "images") {
        content.images = input.value.split(",").map((s) => ({ url: s.trim() })).filter((i) => i.url);
      } else {
        content[key] = input.value;
      }
    });

    if (type === "cards") {
      content.items = Array.from(document.querySelectorAll("#cards-items .card-item")).map((row) => {
        const item = {};
        row.querySelectorAll(".f-item-input").forEach((input) => {
          item[input.dataset.key] = input.value;
        });
        item.description = row._quill ? row._quill.root.innerHTML : "";
        return item;
      });
    }

    const isEdit = !!blockIdInput.value;
    const url = isEdit
      ? `/api/admin/halaman/${pageId}/blocks/${blockIdInput.value}`
      : `/api/admin/halaman/${pageId}/blocks`;
    const method = isEdit ? "PUT" : "POST";

    try {
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ blockType: type, content }),
      });
      if (!res.ok) {
        errorBox.textContent = "Gagal menyimpan blok";
        errorBox.classList.remove("hidden");
        return;
      }
      location.reload();
    } catch {
      errorBox.textContent = "Terjadi kesalahan, coba lagi.";
      errorBox.classList.remove("hidden");
    }
  });
</script>