---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { prisma } from "../../../lib/prisma";

export const prerender = false;

const footer = await prisma.setting.findUnique({
  where: { key: "footer" }
});
---

<AdminLayout title="Footer">
  <div class="max-w-2xl mx-auto">
    <div class="bg-neutral-white rounded-xl shadow-sm p-8">
      <h2 class="font-heading text-2xl font-semibold mb-6">Edit Footer Website</h2>

      <form id="form-footer" class="space-y-6">
        <input type="hidden" id="f-key" value="footer" />

        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Judul Footer</label>
          <input id="f-title" value={footer?.footerText || ""} class="w-full px-4 py-3 border border-neutral-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Logo Footer</label>
          <input type="file" id="f-logo-file" accept="image/*" class="w-full text-sm" />
          <input type="hidden" id="f-logo-url" value={footer?.footerLogo || ""} />
          <img id="preview-logo" src={footer?.footerLogo || ""} class="mt-3 max-h-24 rounded-lg hidden" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">WhatsApp</label>
            <input id="f-whatsapp" value={footer?.whatsapp || ""} class="w-full px-4 py-3 border border-neutral-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label class="block text-sm font-medium text-neutral-dark mb-1">Email</label>
            <input id="f-email" value={footer?.email || ""} class="w-full px-4 py-3 border border-neutral-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-neutral-dark mb-1">Copyright Text</label>
          <input id="f-copyright" value={footer?.copyright || ""} class="w-full px-4 py-3 border border-neutral-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div class="pt-4">
          <button type="submit" class="w-full bg-primary text-white py-3.5 rounded-lg font-medium hover:opacity-90">
            Simpan Perubahan Footer
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
const form = document.getElementById("form-footer") as HTMLFormElement | null;

const logoInput = document.getElementById("f-logo-file") as HTMLInputElement | null;
const logoUrl = document.getElementById("f-logo-url") as HTMLInputElement | null;
const preview = document.getElementById("preview-logo") as HTMLImageElement | null;

logoInput?.addEventListener("change", async (e) => {

    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];

    if (!file) return;

    const fd = new FormData();
    fd.append("file", file);

    const res = await fetch("/api/admin/upload", {
        method: "POST",
        body: fd
    });

    const data = await res.json();

    if (logoUrl) logoUrl.value = data.url;

    if (preview) {
        preview.src = data.url;
        preview.classList.remove("hidden");
    }

});

form?.addEventListener("submit", async (e) => {

    e.preventDefault();

    const payload = {
        footerText: (document.getElementById("f-title") as HTMLInputElement)?.value ?? "",
        footerLogo: (document.getElementById("f-logo-url") as HTMLInputElement)?.value ?? "",
        whatsapp: (document.getElementById("f-whatsapp") as HTMLInputElement)?.value ?? "",
        email: (document.getElementById("f-email") as HTMLInputElement)?.value ?? "",
        copyright: (document.getElementById("f-copyright") as HTMLInputElement)?.value ?? ""
    };

    console.log(payload);

    const res = await fetch("/api/admin/footer", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(payload)
    });

    const result = await res.text();

    console.log(result);

    if (res.ok) {
        alert("Berhasil");
        location.reload();
    } else {
        alert(result);
    }

});
</script>