---
import PublicLayout from "../layouts/PublicLayout.astro";
export const prerender = false;
---

<PublicLayout title="Kontak">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="max-w-xl">
      <p class="font-heading text-sm font-semibold text-primary uppercase tracking-wide">Kontak</p>
      <h1 class="mt-2 font-heading text-3xl font-bold text-neutral-dark">Hubungi Kami</h1>
      <p class="mt-3 font-body text-neutral-dark/70">
        Ada pertanyaan soal pendaftaran, pembayaran, atau teknis lomba? Tim kami siap bantu.
      </p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <div>
        <div class="space-y-5">
          <div class="flex gap-4">
            <div class="mt-0.5 h-9 w-9 shrink-0 rounded-lg bg-primary/10 grid place-items-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-primary">
                <path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z" stroke="currentColor" stroke-width="2" />
                <circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="2" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-neutral-dark">Alamat</h3>
              <p class="mt-1 font-body text-sm text-neutral-dark/70">
                Kantor Jawa Pos Radar Kediri, Kota Kediri, Jawa Timur
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="mt-0.5 h-9 w-9 shrink-0 rounded-lg bg-secondary/10 grid place-items-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-secondary">
                <path d="M3 5.5A2.5 2.5 0 015.5 3h13A2.5 2.5 0 0121 5.5v13a2.5 2.5 0 01-2.5 2.5h-13A2.5 2.5 0 013 18.5v-13z" stroke="currentColor" stroke-width="2" />
                <path d="M7 9l5 4 5-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-neutral-dark">Email</h3>
              <a href="mailto:info@kkakediri.com" class="mt-1 block font-body text-sm text-neutral-dark/70 hover:text-primary">
                info@kkakediri.com
              </a>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="mt-0.5 h-9 w-9 shrink-0 rounded-lg bg-accent/10 grid place-items-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="text-accent">
                <path d="M4 4l4 12 4-8 8 4-12-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-neutral-dark">WhatsApp</h3>
              <a href="https://wa.me/6281234567890" class="mt-1 block font-body text-sm text-neutral-dark/70 hover:text-primary">
                +62 812-3456-7890
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 rounded-xl overflow-hidden border border-neutral-gray">
          <iframe
            title="Lokasi Radar Kediri"
            src="https://maps.google.com/maps?q=Kediri&z=13&output=embed"
            class="w-full h-64"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <div class="rounded-xl border border-neutral-gray p-6 sm:p-8">
        <h2 class="font-heading text-lg font-semibold text-neutral-dark">Kirim Pesan</h2>
        <p class="mt-1 font-body text-sm text-neutral-dark/60">
          Isi form di bawah, tim kami akan membalas secepatnya.
        </p>

        <form id="form-kontak" class="mt-6 space-y-4">
          <div>
            <label for="name" class="font-body text-sm font-medium text-neutral-dark">Nama</label>
            <input id="name" required placeholder="Nama lengkap" class="mt-1.5 w-full rounded-lg border border-neutral-gray px-4 py-2.5 font-body text-sm focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="email" class="font-body text-sm font-medium text-neutral-dark">Email</label>
              <input id="email" type="email" required placeholder="nama@email.com" class="mt-1.5 w-full rounded-lg border border-neutral-gray px-4 py-2.5 font-body text-sm focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <div>
              <label for="phone" class="font-body text-sm font-medium text-neutral-dark">No. HP</label>
              <input id="phone" type="tel" placeholder="08xxxxxxxxxx" class="mt-1.5 w-full rounded-lg border border-neutral-gray px-4 py-2.5 font-body text-sm focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
          </div>

          <div>
            <label for="message" class="font-body text-sm font-medium text-neutral-dark">Pesan</label>
            <textarea id="message" rows="4" required placeholder="Tulis pertanyaan atau pesan kamu di sini..." class="mt-1.5 w-full rounded-lg border border-neutral-gray px-4 py-2.5 font-body text-sm focus:outline-none focus:ring-2 focus:ring-primary/40"></textarea>
          </div>

          <div id="form-error" class="hidden bg-red-50 text-red-600 text-sm rounded-lg px-4 py-2.5"></div>
          <div id="form-success" class="hidden bg-emerald-50 text-emerald-700 text-sm rounded-lg px-4 py-2.5"></div>

          <button type="submit" id="btn-submit" class="w-full font-heading text-sm font-semibold bg-primary text-neutral-white px-6 py-3 rounded-lg hover:opacity-90 transition-opacity disabled:opacity-60">
            Kirim Pesan
          </button>
        </form>
      </div>
    </div>
  </section>
</PublicLayout>

<script>
  const form = document.getElementById("form-kontak") as HTMLFormElement;
  const errorBox = document.getElementById("form-error") as HTMLDivElement;
  const successBox = document.getElementById("form-success") as HTMLDivElement;
  const btn = document.getElementById("btn-submit") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");
    successBox.classList.add("hidden");
    btn.disabled = true;
    btn.textContent = "Mengirim...";

    const payload = {
      nama: (document.getElementById("name") as HTMLInputElement).value,
      email: (document.getElementById("email") as HTMLInputElement).value,
      telepon: (document.getElementById("phone") as HTMLInputElement).value,
      pesan: (document.getElementById("message") as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch("/api/kontak", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        errorBox.textContent = data.message || "Gagal mengirim pesan.";
        errorBox.classList.remove("hidden");
      } else {
        successBox.textContent = "Pesan berhasil dikirim, terima kasih!";
        successBox.classList.remove("hidden");
        form.reset();
      }
    } catch {
      errorBox.textContent = "Terjadi kesalahan, coba lagi.";
      errorBox.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Kirim Pesan";
    }
  });
</script>