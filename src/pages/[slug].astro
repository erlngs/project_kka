---
import PublicLayout from "../layouts/PublicLayout.astro";
import { prisma } from "../lib/prisma";

export const prerender = false;

const { slug } = Astro.params;

const page = await prisma.page.findUnique({
  where: { slug },
  include: { blocks: { orderBy: { orderIndex: "asc" } } },
});

if (!page || !page.isPublished) {
  return new Response(null, { status: 404 });
}
---

<PublicLayout title={page.title}>
  <div class="max-w-4xl mx-auto px-6 py-12">
    {page.blocks.map((block) => {
      const c = block.content;
      switch (block.blockType) {
        case "heading":
          return <h2 class="font-heading text-2xl font-bold mb-4">{c.text}</h2>;
        case "paragraph":
          return <p class="text-neutral-dark/80 mb-6 leading-relaxed">{c.text}</p>;
        case "image":
          return (
            <figure class="mb-6">
              <img src={c.image_url} alt={c.alt || ""} class="rounded-xl w-full" />
              {c.caption && <figcaption class="text-sm text-neutral-dark/50 mt-2 text-center">{c.caption}</figcaption>}
            </figure>
          );
        case "gallery":
          return (
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-6">
              {(c.images || []).map((img) => <img src={img.url} class="rounded-lg w-full h-40 object-cover" />)}
            </div>
          );
        case "testimonial":
          return (
            <blockquote class="bg-neutral-gray rounded-xl p-5 mb-6">
              <p class="italic text-neutral-dark/80">"{c.message}"</p>
              <footer class="mt-3 text-sm font-medium">{c.name} — {c.role}</footer>
            </blockquote>
          );
        case "cta_button":
          return (
            <a href={c.url} class="inline-block bg-primary text-neutral-white px-6 py-3 rounded-lg font-medium mb-6">
              {c.label}
            </a>
          );
        default:
          return null;
      }
    })}
  </div>
</PublicLayout>