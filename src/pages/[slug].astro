---
import PublicLayout from "../layouts/PublicLayout.astro";
import { prisma } from "../lib/prisma";

export const prerender = false;

const { slug } = Astro.params;

const page = await prisma.page.findUnique({
  where: { slug },
  include: {
    blocks: {
      orderBy: { orderIndex: "asc" },
    },
  },
});

if (!page || !page.isPublished) {
  return new Response(null, { status: 404 });
}

const cardIcons: Record<string, string> = {
  lightbulb: "💡",
  target: "🎯",
  star: "⭐",
  shield: "🛡️",
  users: "👥",
  check: "✅",
};
---

<PublicLayout title={page.title} description={page.metaDescription ?? page.heroSubtitle}>

  <!-- HERO BANNER - VERSI DEBUG -->
  <section class="relative h-[420px] md:h-[520px] flex items-center justify-center text-center overflow-hidden bg-neutral-800">
    {page.heroImageUrl ? (
      <>
        <img
          src={page.heroImageUrl}
          alt={page.title}
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/70"></div>
      </>
    ) : (
      <div class="absolute inset-0 bg-neutral-700 flex items-center justify-center">
        <p class="text-white text-xl">❌ Tidak ada gambar banner</p>
      </div>
    )}

    <div class="relative z-10 max-w-3xl px-6 text-white">
      <h1 class="font-heading text-3xl md:text-5xl font-bold mb-4 leading-tight">
        {page.title}
      </h1>
      {page.heroSubtitle && (
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          {page.heroSubtitle}
        </p>
      )}
    </div>
  </section>

  <!-- Konten Blok -->
  <div class="max-w-4xl mx-auto px-6 py-12">
    {page.blocks.map((block) => {
      const c = block.content as any;

      switch (block.blockType) {
        case "heading":
          return (
            <h2 class="font-heading text-2xl font-bold mb-6 card-description" set:html={c.text} />
          );

        case "paragraph":
          return (
            <div class="text-neutral-dark/80 mb-6 leading-relaxed card-description" set:html={c.text} />
          );

        case "image":
          return (
            <figure class="mb-8">
              <img src={c.image_url} alt={c.alt || ""} class="rounded-xl w-full" />
              {c.caption && <figcaption class="text-center text-sm text-neutral-dark/70 mt-2">{c.caption}</figcaption>}
            </figure>
          );

        case "gallery":
  return (
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
      {(c.images || []).map((img: any, i: number) => (
        <div class="relative group overflow-hidden rounded-lg cursor-pointer">
          <img
            src={img.url}
            alt={img.alt || ""}
            class="lightbox-img w-full h-52 object-cover transition-transform duration-300 group-hover:scale-105"
            data-index={i}
            data-full={img.url}
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-300 flex items-center justify-center pointer-events-none">
            <svg
              width="32"
              height="32"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              class="text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 scale-75 group-hover:scale-100"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  );

        case "testimonial":
          return (
            <blockquote class="bg-neutral-gray rounded-2xl p-6 mb-8 italic">
              <div class="card-description" set:html={c.message} />
              <footer class="mt-4 text-sm font-medium not-italic">
                — {c.name}{c.role ? `, ${c.role}` : ""}
              </footer>
            </blockquote>
          );

        case "cta_button":
          return (
            <a href={c.url} class="inline-block bg-primary text-white px-8 py-3.5 rounded-lg font-medium">
              {c.text || c.label}
            </a>
          );

        case "cards":
          return (
            <section class="mb-16 text-center">
              {c.eyebrow && (
                <p class="text-primary font-bold tracking-wide text-sm mb-2 uppercase">{c.eyebrow}</p>
              )}
              {c.title && (
                <h2 class="font-heading text-3xl font-bold mb-3">{c.title}</h2>
              )}
              <div class="w-16 h-1 bg-primary mx-auto mb-10"></div>
              <div class="grid gap-6 text-left md:grid-cols-2">
                {(c.items || []).map((item: any) => (
                  <div class="group bg-white rounded-2xl shadow-md border border-neutral-100 p-8 transition-all duration-300 ease-out hover:shadow-2xl hover:-translate-y-1 hover:scale-[1.02] hover:border-primary/20">
                    {item.icon && cardIcons[item.icon] && (
                      <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-4 text-2xl mx-auto transition-transform duration-300 group-hover:scale-110">
                        {cardIcons[item.icon]}
                      </div>
                    )}
                    <h3 class="font-heading text-xl font-bold mb-3 text-center">{item.title}</h3>
                    <div class="text-neutral-dark/70 leading-relaxed text-left card-description" set:html={item.description} />
                  </div>
                ))}
              </div>
            </section>
          );

        default:
          return null;
      }
    })}
  </div>
  <!-- Lightbox Modal -->
  <div id="lightbox" class="hidden fixed inset-0 bg-black/90 z-[100] flex items-center justify-center p-4">
    <button id="lightbox-close" aria-label="Tutup" class="absolute top-5 right-5 text-white/80 hover:text-white">
      <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <button id="lightbox-prev" aria-label="Sebelumnya" class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white">
      <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <img id="lightbox-image" src="" alt="" class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain" />

    <button id="lightbox-next" aria-label="Berikutnya" class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white">
      <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</PublicLayout>
<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement;
  const btnClose = document.getElementById("lightbox-close");
  const btnPrev = document.getElementById("lightbox-prev");
  const btnNext = document.getElementById("lightbox-next");

  let currentGallery: string[] = [];
  let currentIndex = 0;

  function openLightbox(images: string[], index: number) {
    currentGallery = images;
    currentIndex = index;
    lightboxImage.src = currentGallery[currentIndex];
    lightbox?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  function showImage(offset: number) {
    currentIndex = (currentIndex + offset + currentGallery.length) % currentGallery.length;
    lightboxImage.src = currentGallery[currentIndex];
  }

  // Kelompokkan gambar per galeri (satu blok gallery = satu grup navigasi)
  document.querySelectorAll(".grid").forEach((grid) => {
    const imgsInGrid = Array.from(grid.querySelectorAll<HTMLImageElement>(".lightbox-img"));
    if (imgsInGrid.length === 0) return;

    const urls = imgsInGrid.map((img) => img.dataset.full || img.src);

    imgsInGrid.forEach((img, i) => {
      img.addEventListener("click", () => openLightbox(urls, i));
    });
  });

  btnClose?.addEventListener("click", closeLightbox);
  btnPrev?.addEventListener("click", () => showImage(-1));
  btnNext?.addEventListener("click", () => showImage(1));

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (lightbox?.classList.contains("hidden")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showImage(-1);
    if (e.key === "ArrowRight") showImage(1);
  });
</script>
<style is:global>
  .ql-align-center { text-align: center; }
  .ql-align-right { text-align: right; }
  .ql-align-justify { text-align: justify; }
  .ql-size-small { font-size: 0.75em; }
  .ql-size-large { font-size: 1.5em; }
  .ql-size-huge { font-size: 2.5em; }

  /* reset list style yang dihapus Tailwind preflight, khusus konten dari rich text editor */
  .card-description ol {
    list-style: decimal;
    padding-left: 1.5em;
  }
  .card-description ul {
    list-style: disc;
    padding-left: 1.5em;
  }
  .card-description p:last-child {
    margin-bottom: 0;
  }
</style>