---
import PublicLayout from "../../layouts/PublicLayout.astro";
import { prisma } from "../../lib/prisma";

export const prerender = false;

const slug = Astro.params.slug;

if (!slug) {
  return Astro.redirect("/blog");
}

const article = await prisma.article.findUnique({ where: { slug } });

if (!article || !article.publishedAt) {
  return Astro.redirect("/blog");
}

const placeholder = "https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1200&q=80";

function formatDate(d: Date) {
  return new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "long", year: "numeric" }).format(d);
}

const paragraphs = article.content.split(/\n\s*\n/).filter((p) => p.trim());

const tagList = article.tags ? article.tags.split(",").map((t) => t.trim()).filter(Boolean) : [];

const relatedArticles = await prisma.article.findMany({
  where: { publishedAt: { not: null }, NOT: { id: article.id } },
  orderBy: { publishedAt: "desc" },
  take: 3,
});

const siteUrl = Astro.url.origin;
const canonicalUrl = `${siteUrl}/blog/${article.slug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.metaDescription ?? article.excerpt ?? "",
  image: article.thumbnail ?? placeholder,
  author: { "@type": "Person", name: article.author ?? "Admin KKA" },
  datePublished: article.publishedAt.toISOString(),
  dateModified: article.updatedAt.toISOString(),
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
};
---

<PublicLayout title={article.title} description={article.metaDescription ?? article.excerpt}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={article.metaDescription ?? article.excerpt ?? ""} />
    <meta property="og:image" content={article.thumbnail ?? placeholder} />
    <meta property="og:type" content="article" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="bg-neutral-gray py-10">
    <div class="max-w-6xl mx-auto px-6">
      <a href="/blog" class="inline-flex items-center gap-1.5 font-body text-sm text-neutral-dark/70 hover:text-primary transition-colors">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Kembali ke Artikel
      </a>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 lg:grid-cols-3 gap-10">
    <article class="lg:col-span-2">
      <div>
        {article.category && (
          <span class="font-body text-xs font-semibold text-secondary uppercase tracking-wide">{article.category}</span>
        )}
        <h1 class="mt-2 font-heading text-3xl sm:text-4xl font-bold text-neutral-dark leading-tight">
          {article.title}
        </h1>
        <div class="mt-4 flex items-center gap-2 font-body text-sm text-neutral-dark/65">
          {article.author && <span>Oleh <strong class="text-neutral-dark">{article.author}</strong></span>}
          {article.author && <span>•</span>}
          <span>{formatDate(article.publishedAt)}</span>
        </div>
      </div>

      <div class="mt-8 rounded-xl overflow-hidden shadow-sm">
        <img
          src={article.thumbnail ?? placeholder}
          alt={article.title}
          class="w-full h-72 sm:h-96 object-cover"
          width="1200"
          height="600"
        />
      </div>

      <div class="mt-10 font-body text-neutral-dark/80 leading-relaxed flex flex-col gap-5 text-[15px]">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {tagList.length > 0 && (
        <div class="mt-10 pt-6 border-t border-neutral-gray flex flex-wrap items-center gap-2">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-neutral-dark/40">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          {tagList.map((tag) => (
            <span class="bg-neutral-gray text-neutral-dark/70 text-xs px-3 py-1.5 rounded-full">{tag}</span>
          ))}
        </div>
      )}
    </article>

    <aside class="flex flex-col gap-6">
      {relatedArticles.length > 0 && (
        <div class="bg-neutral-white rounded-2xl shadow-sm p-6">
          <h2 class="font-heading font-semibold text-neutral-dark mb-4 pb-3 border-b-2 border-primary inline-block">
            Rekomendasi Artikel
          </h2>
          <div class="flex flex-col gap-4 mt-2">
            {relatedArticles.map((related) => (
              <a href={`/blog/${related.slug}`} class="flex gap-3 group">
                <img
                  src={related.thumbnail ?? placeholder}
                  alt={related.title}
                  class="w-16 h-16 rounded-lg object-cover shrink-0"
                />
                <div>
                  {related.category && (
                    <span class="text-secondary text-[11px] font-semibold uppercase">{related.category}</span>
                  )}
                  <h3 class="text-sm font-medium text-neutral-dark leading-snug group-hover:text-primary transition-colors">
                    {related.title}
                  </h3>
                  {related.publishedAt && (
                    <p class="text-xs text-neutral-dark/50 mt-1">{formatDate(related.publishedAt)}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="bg-gradient-to-br from-primary to-blue-800 rounded-2xl p-6 text-neutral-white">
        <h2 class="font-heading text-lg font-bold mb-2">Siap Menguji Kemampuanmu?</h2>
        <p class="text-sm text-white/85 mb-5 leading-relaxed">
          Daftarkan dirimu sekarang juga di KKA Radar Kediri 2026 dan raih penghargaan bergengsi!
        </p>
        <div class="flex flex-col gap-2.5">
          <a href="/daftar" class="bg-neutral-white text-primary text-center text-sm font-semibold py-2.5 rounded-lg hover:opacity-90 transition-opacity">
            Daftar Mandiri
          </a>
          <a href="/daftar-kolektif" class="border border-white/40 text-neutral-white text-center text-sm font-semibold py-2.5 rounded-lg hover:bg-white/10 transition-colors">
            Daftar Kolektif
          </a>
        </div>
      </div>
    </aside>
  </div>
</PublicLayout>