---
import PublicLayout from "../../layouts/PublicLayout.astro";
import { prisma } from "../../lib/prisma";

export const prerender = false;

const slug = Astro.params.slug;

if (!slug) {
  return Astro.redirect("/blog");
}

const article = await prisma.article.findUnique({
  where: { slug },
});

if (!article || !article.publishedAt) {
  return Astro.redirect("/blog");
}

const placeholder =
  "https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1200&q=80";

function formatDate(d: Date) {
  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(d);
}

const paragraphs = article.content
  .split(/\n\s*\n/)
  .filter((p) => p.trim());

const relatedArticles = await prisma.article.findMany({
  where: {
    publishedAt: {
      not: null,
    },
    category: article.category,
    NOT: {
      id: article.id,
    },
  },
  orderBy: {
    publishedAt: "desc",
  },
  take: 3,
});
---

<PublicLayout title={article.title}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 font-body text-sm text-neutral-dark/60 hover:text-primary transition-colors mb-8"
    >
      <svg
        width="16"
        height="16"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"
        />
      </svg>

      Kembali ke Blog
    </a>

    <div>
      {article.category && (
        <span class="font-body text-xs font-semibold text-secondary uppercase tracking-wide">
          {article.category}
        </span>
      )}

      <h1 class="mt-2 font-heading text-3xl sm:text-4xl font-bold text-neutral-dark leading-tight">
        {article.title}
      </h1>

      <div class="mt-4 flex items-center gap-2 font-body text-sm text-neutral-dark/50">
        {article.author && <span>{article.author}</span>}

        {article.author && <span>•</span>}

        <span>{formatDate(article.publishedAt)}</span>
      </div>
    </div>

    <div class="mt-8 rounded-xl overflow-hidden shadow-sm">
      <img
        src={article.thumbnail ?? placeholder}
        alt={article.title}
        class="w-full h-72 sm:h-96 object-cover"
      />
    </div>

    <div class="mt-10 font-body text-neutral-dark/80 leading-relaxed flex flex-col gap-5 text-[15px]">
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="bg-neutral-gray py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="font-heading font-semibold text-lg text-neutral-dark mb-5">
          Artikel Terkait
        </h2>

        <div class="grid gap-4 sm:grid-cols-3">
          {relatedArticles.map((related) => (
            <a
              href={`/blog/${related.slug}`}
              class="block rounded-xl bg-neutral-white p-4 shadow-sm hover:shadow-md transition-shadow"
            >
              <h3 class="font-heading text-sm font-semibold text-neutral-dark leading-snug">
                {related.title}
              </h3>

              {related.publishedAt && (
                <p class="mt-2 text-xs text-neutral-dark/50">
                  {formatDate(related.publishedAt)}
                </p>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</PublicLayout>