---
import PublicLayout from "../../layouts/PublicLayout.astro";
import { prisma } from "../../lib/prisma";

export const prerender = false;

const { code } = Astro.params;

const invoice = await prisma.invoice.findUnique({
  where: { invoiceCode: code },
  include: {
    pendaftaran: { include: { wilayah: true, gelombang: true } },
    batch: { include: { wilayah: true, gelombang: true, pendaftaran: true } },
  },
});

if (!invoice) return new Response(null, { status: 404 });

const rekening = invoice.status === "menunggu_pembayaran" || invoice.status === "ditolak"
  ? await prisma.setting.findUnique({ where: { key: "rekening" } })
  : null;

function formatRupiah(n: number) {
  return new Intl.NumberFormat("id-ID", { 
    style: "currency", 
    currency: "IDR", 
    minimumFractionDigits: 0 
  }).format(n);
}
---

<PublicLayout title="Invoice Pendaftaran">
  <div class="max-w-xl mx-auto px-6 py-12">
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="font-heading text-xl font-bold text-neutral-dark">Pendaftaran Berhasil!</h1>
      <p class="text-sm text-neutral-dark/70 mt-1">Selesaikan pembayaran untuk mengonfirmasi pendaftaranmu.</p>
    </div>

    <!-- Invoice Summary Card -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4 flex items-start gap-3">
  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-amber-600 shrink-0 mt-0.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
  </svg>
  <p class="text-sm text-amber-700">
    <strong>Penting:</strong> Simpan atau salin kode invoice di bawah ini. Kamu akan membutuhkannya untuk mengecek status pendaftaran & pembayaran kapan saja lewat halaman <a href="/cek-status" class="underline font-medium">Cek Status Pendaftaran</a>.
  </p>
</div>

<div class="bg-neutral-white rounded-xl shadow-sm p-6 mb-6">
  <div class="flex justify-between items-center border-b border-neutral-gray pb-4 mb-4">
    <span class="text-sm text-neutral-dark/70">Kode Invoice</span>
    <div class="flex items-center gap-2">
      <span id="invoice-code-text" class="font-heading font-bold text-primary">{invoice.invoiceCode}</span>
      <button
        id="btn-copy-code"
        type="button"
        class="text-neutral-dark/40 hover:text-primary transition-colors"
        title="Salin kode invoice"
      >
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </button>
    </div>
  </div>
      
      <div class="flex flex-col gap-2 text-sm">
  {invoice.batch ? (
    <>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Koordinator</span>
        <span class="text-neutral-dark font-medium">{invoice.batch.namaKoordinator}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Sekolah</span>
        <span class="text-neutral-dark">{invoice.batch.namaSekolah}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Wilayah</span>
        <span class="text-neutral-dark">{invoice.batch.wilayah?.nama ?? "-"}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Gelombang</span>
        <span class="text-neutral-dark">{invoice.batch.gelombang?.nama ?? "-"}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Jumlah Siswa</span>
        <span class="text-neutral-dark font-medium">{invoice.batch.pendaftaran.length} siswa</span>
      </div>
    </>
  ) : (
    <>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Nama Siswa</span>
        <span class="text-neutral-dark font-medium">{invoice.pendaftaran?.namaSiswa}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Wilayah</span>
        <span class="text-neutral-dark">{invoice.pendaftaran?.wilayah?.nama ?? "-"}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-neutral-dark/70">Gelombang</span>
        <span class="text-neutral-dark">{invoice.pendaftaran?.gelombang?.nama ?? "-"}</span>
      </div>
    </>
  )}
        
        <div class="flex justify-between border-t border-neutral-gray pt-2 mt-1">
          <span class="text-neutral-dark font-medium">Total Tagihan</span>
          <span class="text-secondary font-heading font-bold text-lg">
            {formatRupiah(Number(invoice.jumlahTagihan))}
          </span>
        </div>

        <!-- Status Badge -->
        <div class="flex justify-between border-t border-neutral-gray pt-2 mt-1">
          <span class="text-neutral-dark font-medium">Status</span>
          <span class={`px-2.5 py-1 rounded-full text-xs font-medium ${
            invoice.status === "terverifikasi" ? "bg-emerald-100 text-emerald-700" :
            invoice.status === "menunggu_verifikasi" ? "bg-blue-100 text-blue-700" :
            invoice.status === "ditolak" ? "bg-red-100 text-red-700" :
            "bg-amber-100 text-amber-700"
          }`}>
            {invoice.status.replace(/_/g, " ")}
          </span>
        </div>
      </div>
    </div>

    {
      rekening && (rekening.bankNama || rekening.bankNorek) && (
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6">
          <p class="text-sm font-medium text-neutral-dark mb-2">Transfer ke rekening berikut:</p>
          <div class="flex justify-between text-sm">
            <span class="text-neutral-dark/70">Bank</span>
            <span class="text-neutral-dark font-medium">{rekening.bankNama}</span>
          </div>
          <div class="flex justify-between text-sm mt-1">
            <span class="text-neutral-dark/70">No. Rekening</span>
            <span class="text-neutral-dark font-bold">{rekening.bankNorek}</span>
          </div>
          <div class="flex justify-between text-sm mt-1">
            <span class="text-neutral-dark/70">Atas Nama</span>
            <span class="text-neutral-dark font-medium">{rekening.bankAtasNama}</span>
          </div>
        </div>
      )
    }

    <!-- Conditional Content -->
    {
      invoice.status === "menunggu_pembayaran" && (
        <form id="form-bukti" class="bg-neutral-white rounded-xl shadow-sm p-6 flex flex-col gap-3">
          <label class="block text-sm font-medium text-neutral-dark">Upload Bukti Pembayaran</label>
          <input type="file" id="f-bukti" accept="image/*" class="w-full text-sm" required />
          <img id="preview-bukti" class="hidden rounded-lg max-h-40" />
          <div id="bukti-error" class="hidden bg-red-50 text-red-600 text-sm rounded-lg px-4 py-2.5"></div>
          <div id="bukti-success" class="hidden bg-emerald-50 text-emerald-700 text-sm rounded-lg px-4 py-2.5"></div>
          <button type="submit" id="btn-bukti" class="bg-primary text-neutral-white font-medium py-2.5 rounded-lg hover:opacity-90 disabled:opacity-60">
            Kirim Bukti Pembayaran
          </button>
        </form>
      )
    }

    {
      invoice.status === "menunggu_verifikasi" && (
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 text-center">
          <p class="font-medium text-blue-700">Bukti pembayaran sedang diverifikasi admin.</p>
          <p class="text-sm text-blue-600 mt-1">Mohon tunggu, cek kembali halaman ini secara berkala.</p>
        </div>
      )
    }

    {
      invoice.status === "terverifikasi" && (
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6 text-center">
          <p class="font-medium text-emerald-700">Pembayaran terverifikasi pendaftaran kamu LUNAS.</p>
          <p class="text-sm text-emerald-600 mt-1">Sampai jumpa di hari pelaksanaan KKA 2026!</p>
        </div>
      )
    }

    {
      invoice.status === "ditolak" && (
        <div class="bg-red-50 border border-red-200 rounded-xl p-6">
          <p class="font-medium text-red-700 mb-1">Bukti pembayaran ditolak</p>
          <p class="text-sm text-red-600 mb-4">{invoice.catatanAdmin ?? "Tidak ada catatan dari admin."}</p>
          
          <form id="form-bukti" class="flex flex-col gap-3">
            <label class="block text-sm font-medium text-neutral-dark">Upload Ulang Bukti Pembayaran</label>
            <input type="file" id="f-bukti" accept="image/*" class="w-full text-sm" required />
            <img id="preview-bukti" class="hidden rounded-lg max-h-40" />
            <div id="bukti-error" class="hidden bg-red-50 text-red-600 text-sm rounded-lg px-4 py-2.5"></div>
            <div id="bukti-success" class="hidden bg-emerald-50 text-emerald-700 text-sm rounded-lg px-4 py-2.5"></div>
            <button type="submit" id="btn-bukti" class="bg-primary text-neutral-white font-medium py-2.5 rounded-lg hover:opacity-90 disabled:opacity-60">
              Kirim Ulang Bukti
            </button>
          </form>
        </div>
      )
    }
  </div>
</PublicLayout>

<script define:vars={{ invoiceCode: invoice.invoiceCode }}>
  // Simpan kode invoice biar bisa diingatkan lagi kalau belum selesai bayar
if (invoiceCode) {
  localStorage.setItem("kka_last_invoice", invoiceCode);
}
  const btnCopy = document.getElementById("btn-copy-code");

  btnCopy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(invoiceCode);

      const originalTitle = btnCopy.title;
      btnCopy.title = "Tersalin!";
      btnCopy.classList.add("text-emerald-600");

      setTimeout(() => {
        btnCopy.title = originalTitle;
        btnCopy.classList.remove("text-emerald-600");
      }, 1500);
    } catch {
      alert("Gagal menyalin, silakan salin manual: " + invoiceCode);
    }
  });

  const fileInput = document.getElementById("f-bukti");
  const preview = document.getElementById("preview-bukti");
  const form = document.getElementById("form-bukti");
  const errorBox = document.getElementById("bukti-error");
  const successBox = document.getElementById("bukti-success");
  const btn = document.getElementById("btn-bukti");

  fileInput?.addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (!file) return;
    preview.src = URL.createObjectURL(file);
    preview.classList.remove("hidden");
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.classList.add("hidden");
    successBox.classList.add("hidden");

    const file = fileInput.files[0];
    if (!file) return;

    btn.disabled = true;
    btn.textContent = "Mengunggah...";

    const fd = new FormData();
    fd.append("file", file);
    fd.append("invoiceCode", invoiceCode);

    try {
      const res = await fetch("/api/pembayaran/upload-bukti", { 
        method: "POST", 
        body: fd 
      });
      const data = await res.json();

      if (!res.ok) {
        errorBox.textContent = data.message || "Gagal mengunggah bukti.";
        errorBox.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = btn.textContent.includes("Ulang") ? "Kirim Ulang Bukti" : "Kirim Bukti Pembayaran";
      } else {
        successBox.textContent = "Bukti pembayaran berhasil dikirim, menunggu verifikasi admin.";
        successBox.classList.remove("hidden");
        btn.textContent = "Terkirim";
      }
    } catch {
      errorBox.textContent = "Terjadi kesalahan, coba lagi.";
      errorBox.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = btn.textContent.includes("Ulang") ? "Kirim Ulang Bukti" : "Kirim Bukti Pembayaran";
    }
  });
</script>