---
import { prisma } from "../../lib/prisma";

const testimoniList = await prisma.testimoni.findMany({
  where: { isActive: true },
  orderBy: { orderIndex: "asc" },
});
---

{testimoniList.length > 0 && (
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-neutral-dark mb-2">Pengalaman dan Kesan KKA Jawa Pos Radar Kediri</h2>
      <p class="text-neutral-dark/70 max-w-lg mx-auto">Apa Kata Mereka?</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimoniList.map((t) => (
        <div class="bg-neutral-white rounded-xl shadow-sm p-6 flex flex-col">
          <div class="flex gap-0.5 mb-4">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill={i < (t.rating ?? 5) ? "#F2B705" : "none"}
                stroke="#F2B705"
                stroke-width="1.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
            ))}
          </div>

          <p class="text-sm text-neutral-dark/70 leading-relaxed flex-1 mb-5">"{t.pesan}"</p>

          <div class="flex items-center gap-3">
            {t.fotoUrl ? (
              <img src={t.fotoUrl} alt={t.nama} class="w-10 h-10 rounded-full object-cover" />
            ) : (
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-heading font-semibold text-sm">
                {t.nama.charAt(0).toUpperCase()}
              </div>
            )}
            <div>
              <p class="text-sm font-medium text-neutral-dark">{t.nama}</p>
              {t.asal && <p class="text-xs text-neutral-dark/65">{t.asal}</p>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
)}