---
import { getNavbarMenu } from "../../lib/navbar";

const allMenu = await getNavbarMenu();

// Menu utama
const topLevel = allMenu.filter((m) => !m.parentId);

// Mapping children
const childrenMap: Record<string, typeof allMenu> = {};

allMenu.forEach((m) => {
  if (m.parentId) {
    childrenMap[m.parentId] ??= [];
    childrenMap[m.parentId].push(m);
  }
});

const currentPath = Astro.url.pathname;

function hrefOf(item: (typeof allMenu)[number]) {
  return item.linkType === "internal_page"
    ? `/${item.target}`
    : item.target;
}
---

<header class="bg-neutral-white shadow-sm sticky top-0 z-30">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" data-astro-prefetch class="flex items-center gap-3">
      <img src="/Logo.png" alt="KKA Kediri Logo" class="h-9 w-auto" />

      <div class="font-heading font-bold text-lg text-neutral-dark">
        KKA <span class="text-secondary-text">Kediri</span>
      </div>
    </a>

    <!-- Desktop -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-dark">

      {
        topLevel.map((item) => {
          const href = hrefOf(item);

          const isActive =
            currentPath === href ||
            (currentPath.startsWith(href) && href !== "/");

          const children = childrenMap[item.id];

          if (children?.length) {
            return (
              <div class="relative group">
                <button
                  type="button"
                  class="flex items-center gap-1 py-1 hover:text-primary transition-colors"
                >
                  {item.label}

                  <svg
                    width="14"
                    height="14"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </button>

                <div class="absolute left-0 top-full pt-2 hidden group-hover:block">
                  <div class="bg-neutral-white rounded-xl shadow-lg py-2 min-w-[200px]">

                    {children.map((child) => (
  <a
    href={hrefOf(child)}
    data-astro-prefetch
    class="block px-4 py-2.5 text-sm text-neutral-dark hover:bg-neutral-gray hover:text-primary transition-colors"
  >
    {child.label}
  </a>
))}

                  </div>
                </div>
              </div>
            );
          }

          return (
  <a
    href={href}
    data-astro-prefetch
    class={`relative py-1 transition-colors hover:text-primary ${
      isActive
        ? "text-primary after:absolute after:bottom-[-2px] after:left-0 after:h-[3px] after:w-full after:bg-blue-600 after:rounded"
        : ""
    }`}
  >
    {item.label}
  </a>
);
        })
      }

      <a
  href="/cek-status"
  data-astro-prefetch
  class="relative py-1 transition-colors hover:text-primary"
>
  Cek Status
</a>

    </div>

    <!-- Mobile Button -->
    <button
      id="menu-toggle"
      class="md:hidden text-neutral-dark"
      type="button"
      aria-label="Buka menu navigasi"
    >
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          id="menu-icon-path"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

  </nav>

  <!-- Overlay -->
  <div
    id="mobile-menu-overlay"
    class="hidden md:hidden fixed inset-0 bg-black/50 z-40"
  ></div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed top-20 left-4 right-4 z-50 bg-neutral-white rounded-2xl shadow-2xl overflow-hidden max-h-[70vh] overflow-y-auto"
  >

    {
      topLevel.map((item) => {
        const href = hrefOf(item);

        const isActive =
          currentPath === href ||
          (currentPath.startsWith(href) && href !== "/");

        const children = childrenMap[item.id];

        if (children?.length) {
          return (
            <details class="border-b border-neutral-gray last:border-0">

              <summary class="px-6 py-4 text-base text-neutral-dark cursor-pointer flex items-center justify-between list-none">

                {item.label}

                <svg
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>

              </summary>

              <div class="bg-neutral-gray/50">

                {children.map((child) => (
  <a
    href={hrefOf(child)}
    data-astro-prefetch
    class="block pl-10 pr-6 py-3 text-sm text-neutral-dark"
  >
    {child.label}
  </a>
))}


              </div>

            </details>
          );
        }

        return (
  <a
    href={href}
    data-astro-prefetch
    class={`block px-6 py-4 text-base border-b border-neutral-gray last:border-0 ${
      isActive
        ? "text-primary font-medium"
        : "text-neutral-dark"
    }`}
  >
    {item.label}
  </a>
);
      })
    }

  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileOverlay = document.getElementById("mobile-menu-overlay");
  const iconPath = document.getElementById("menu-icon-path");

  function openMenu() {
    mobileMenu?.classList.remove("hidden");
    mobileOverlay?.classList.remove("hidden");

    iconPath?.setAttribute(
      "d",
      "M6 18L18 6M6 6l12 12"
    );
  }

  function closeMenu() {
    mobileMenu?.classList.add("hidden");
    mobileOverlay?.classList.add("hidden");

    iconPath?.setAttribute(
      "d",
      "M4 6h16M4 12h16M4 18h16"
    );
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileOverlay?.addEventListener("click", closeMenu);

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>