---
import { prisma } from "../../lib/prisma";

const menu = await prisma.navMenu.findMany({
  where: {
    isActive: true,
    parentId: null,
  },
  orderBy: {
    orderIndex: "asc",
  },
});

const currentPath = Astro.url.pathname;
---

<header class="bg-neutral-white shadow-sm sticky top-0 z-30">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3">
      <img
        src="/Logo.png"
        alt="KKA Kediri Logo"
        class="h-9 w-auto"
      />
      <div class="font-heading font-bold text-lg text-neutral-dark">
        KKA <span class="text-secondary-text">Kediri</span>
      </div>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-dark">

      {menu.map((item) => {
        const href =
          item.linkType === "internal_page"
            ? `/${item.target}`
            : item.target;

        const isActive =
          currentPath === href ||
          (currentPath.startsWith(href) && href !== "/");

        return (
          <a
            href={href}
            class={`relative py-1 transition-colors hover:text-primary ${
              isActive
                ? "text-primary after:absolute after:bottom-[-2px] after:left-0 after:h-[3px] after:w-full after:bg-blue-600 after:rounded"
                : ""
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <a
        href="/cek-status"
        class="relative py-1 transition-colors hover:text-primary"
      >
        Cek Status
      </a>

      <a
        href="/daftar"
        class="bg-primary text-neutral-white px-4 py-2 rounded-lg hover:opacity-90 transition-opacity"
      >
        Daftar Sekarang
      </a>

    </div>

    <!-- Mobile Button -->
    <button
      id="menu-toggle"
      class="md:hidden text-neutral-dark"
      type="button"
      aria-label="Buka menu navigasi"
    >
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          id="menu-icon-path"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

  </nav>

  <!-- Overlay -->
  <div
    id="mobile-menu-overlay"
    class="hidden md:hidden fixed inset-0 bg-black/50 z-40"
  ></div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed top-20 left-4 right-4 z-50 bg-neutral-white rounded-2xl shadow-2xl overflow-hidden"
  >

    {menu.map((item) => {
      const href =
        item.linkType === "internal_page"
          ? `/${item.target}`
          : item.target;

      const isActive =
        currentPath === href ||
        (currentPath.startsWith(href) && href !== "/");

      return (
        <a
          href={href}
          class={`block px-6 py-4 text-base border-b border-neutral-gray last:border-0 ${
            isActive
              ? "text-primary font-medium"
              : "text-neutral-dark"
          }`}
        >
          {item.label}
        </a>
      );
    })}


  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileOverlay = document.getElementById("mobile-menu-overlay");
  const iconPath = document.getElementById("menu-icon-path");

  function openMenu() {
    mobileMenu?.classList.remove("hidden");
    mobileOverlay?.classList.remove("hidden");

    iconPath?.setAttribute(
      "d",
      "M6 18L18 6M6 6l12 12"
    );
  }

  function closeMenu() {
    mobileMenu?.classList.add("hidden");
    mobileOverlay?.classList.add("hidden");

    iconPath?.setAttribute(
      "d",
      "M4 6h16M4 12h16M4 18h16"
    );
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileOverlay?.addEventListener("click", closeMenu);

  // Tutup menu ketika link diklik
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>