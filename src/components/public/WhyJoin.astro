---
const fitur = [
  {
    title: "Uji Kemampuan Akademik",
    desc: "Soal disusun sesuai kurikulum terkini untuk mengukur kemampuan akademikmu secara objektif.",
    icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Hadiah Menarik",
    desc: "Total hadiah jutaan rupiah, sertifikat, dan penghargaan untuk peserta terbaik di setiap jenjang.",
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1",
  },
  {
    title: "Untuk Semua Jenjang",
    desc: "Terbuka untuk siswa SD/MI, SMP/MTs, hingga SMA/MA/SMK se-Karesidenan Kediri.",
    icon: "M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
  },
];
---

<section class="max-w-6xl mx-auto px-6 py-16">
  <div class="text-center mb-12">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-neutral-dark mb-2">Kenapa Ikut KKA?</h2>
    <p class="text-neutral-dark/70 max-w-lg mx-auto">Tiga alasan utama kenapa ribuan pelajar memilih KKA sebagai ajang unjuk prestasi.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {fitur.map((f) => (
      <div class="bg-neutral-white rounded-xl shadow-sm p-6 text-center">
        <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
          <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-neutral-dark mb-2">{f.title}</h3>
        <p class="text-sm text-neutral-dark/70 leading-relaxed">{f.desc}</p>
      </div>
    ))}
  </div>
</section>