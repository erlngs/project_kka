---
import { prisma } from "../../lib/prisma";

const wilayahList = await prisma.wilayah.findMany({
  where: {
    isActive: true,
  },
  orderBy: {
    orderIndex: "asc",
  },
});
---

<section class="bg-neutral-gray py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-neutral-dark mb-2">
        Pilih Wilayahmu
      </h2>

      <p class="text-neutral-dark/60 max-w-lg mx-auto">
        Daftar sesuai wilayah tempat kamu berdomisili atau bersekolah.
      </p>
    </div>

    {
      wilayahList.length === 0 ? (
        <p class="text-center text-neutral-dark/50">
          Belum ada wilayah aktif. Tambahkan dari halaman admin.
        </p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {wilayahList.map((w) => (
            <div class="bg-neutral-white rounded-xl shadow-sm overflow-hidden flex flex-col">
              {w.logoUrl && (
                <img
                  src={w.logoUrl}
                  alt={w.nama}
                  class="h-36 w-full object-cover"
                />
              )}

              <div class="p-6 flex flex-col flex-1">
                <h3 class="font-heading font-semibold text-lg text-neutral-dark mb-2">
                  {w.nama}
                </h3>

                {w.deskripsi && (
                  <p class="text-sm text-neutral-dark/60 mb-4 flex-1">
                    {w.deskripsi}
                  </p>
                )}

                <a
                  href={`/daftar?wilayah=${w.id}`}
                  class="inline-block text-center bg-primary text-neutral-white text-sm font-medium px-5 py-2.5 rounded-lg hover:opacity-90 transition-opacity"
                >
                  Daftar di Wilayah Ini
                </a>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>