---
import { prisma } from "../../lib/prisma";

const wilayahList = await prisma.wilayah.findMany({
  where: { isActive: true },
  orderBy: { orderIndex: "asc" },
});
---

<section class="py-16 bg-gradient-to-b from-neutral-50 to-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-neutral-dark mb-3">
        Pilih Wilayahmu
      </h2>
      <p class="text-neutral-dark/70 max-w-lg mx-auto text-lg">
        Daftar sesuai wilayah tempat kamu berdomisili atau bersekolah
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {wilayahList.map((w) => (
        <div class="group bg-white rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-neutral-100 flex flex-col h-full">
          
          <!-- Logo Area -->
          <div class="h-44 bg-neutral-100 flex items-center justify-center p-6 border-b border-neutral-100">
            {w.logoUrl ? (
              <img 
                src={w.logoUrl} 
                alt={w.nama} 
                class="h-28 w-auto object-contain group-hover:scale-105 transition-transform duration-300"
              />
            ) : (
              <div class="text-neutral-300 text-6xl">🏛️</div>
            )}
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full">
                KKA 2026
              </span>
            </div>

            <h3 class="font-heading text-xl font-semibold text-neutral-dark mb-3">
              {w.nama}
            </h3>

            {w.deskripsi && (
              <p class="text-neutral-dark/70 text-[15px] leading-relaxed mb-6 flex-1">
                {w.deskripsi}
              </p>
            )}

            <!-- Jenjang -->
            <div class="flex gap-2 mb-6">
              <div class="text-xs bg-neutral-100 text-neutral-600 px-3 py-1 rounded-lg flex items-center gap-1">
                <span>🎓</span> SD/MI • SMP/MTs
              </div>
              <div class="text-xs bg-neutral-100 text-neutral-600 px-3 py-1 rounded-lg flex items-center gap-1">
                <span>🎓</span> SMA/MA/SMK
              </div>
            </div>

            <a
              href={`/daftar?wilayah=${w.id}`}
              class="mt-auto block text-center bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium py-3.5 rounded-2xl transition-all active:scale-95"
            >
              Ikut Kompetisi
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>