---
import { prisma } from "../../lib/prisma";

const currentYear = new Date().getFullYear();

const footer = await prisma.setting.findUnique({
  where: {
    key: "footer",
  },
});

const menu = await prisma.navMenu.findMany({
  where: {
    isActive: true,
    parentId: null,
  },
  orderBy: {
    orderIndex: "asc",
  },
});
---

<footer class="bg-neutral-dark text-neutral-white py-12 mt-16">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">

    <div>
      {
        footer?.footerLogo ? (
          <img
            src={footer.footerLogo}
            alt="Logo"
            class="h-20 mb-4"
          />
        ) : (
          <span class="font-heading font-bold text-lg">
            {footer?.footerText ?? "KKA Kediri"}
          </span>
        )
      }

      <p class="text-sm text-neutral-white/60 mt-3 leading-relaxed">
        {footer?.footerText ?? "Kompetisi Kompetensi Akademik"}
      </p>
    </div>

    <div>
  <h4 class="font-heading font-semibold mb-3 text-sm">
    Tautan
  </h4>

  <ul class="text-sm text-neutral-white/60 flex flex-col gap-2">
    {menu.map((item) => {
      const href =
        item.linkType === "internal_page"
          ? `/${item.target}`
          : item.target;

      return (
        <li>
          <a href={href} class="hover:text-white transition-colors">
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</div>

    <div>
      <h4 class="font-heading font-semibold mb-3 text-sm">
        Kontak
      </h4>

      <p class="text-sm text-neutral-white/60">
        WhatsApp: {footer?.whatsapp}
      </p>

      <p class="text-sm text-neutral-white/60">
        Email: {footer?.email}
      </p>
    </div>

  </div>

  <div class="max-w-6xl mx-auto px-6 mt-8 pt-6 border-t border-neutral-white/10 text-xs text-neutral-white/40">
    © {currentYear} {footer?.copyright}
  </div>
</footer>