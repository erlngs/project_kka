---
import { prisma } from "../../lib/prisma";

const currentYear = new Date().getFullYear();

const footer = await prisma.setting.findUnique({ where: { key: "footer" } });

const menu = await prisma.navMenu.findMany({
  where: { isActive: true, parentId: null },
  orderBy: { orderIndex: "asc" },
});

const bantuan = [
  { label: "Cek Status Pendaftaran", href: "/cek-status" },
  { label: "Pendaftaran Mandiri", href: "/daftar" },
  { label: "Pendaftaran Kolektif", href: "/daftar-kolektif" },
  { label: "Hubungi Kami", href: "/kontak" },
];

const socials = [
  { url: footer?.instagramUrl, label: "Instagram", icon: "M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465a4.9 4.9 0 011.771 1.153 4.9 4.9 0 011.153 1.771c.248.637.415 1.363.465 2.428.05 1.066.06 1.405.06 4.122s-.01 3.056-.06 4.122c-.05 1.065-.217 1.79-.465 2.428a4.9 4.9 0 01-1.153 1.771 4.9 4.9 0 01-1.771 1.153c-.637.248-1.363.415-2.428.465-1.066.05-1.405.06-4.122.06s-3.056-.01-4.122-.06c-1.065-.05-1.79-.217-2.428-.465a4.9 4.9 0 01-1.771-1.153 4.9 4.9 0 01-1.153-1.771c-.248-.637-.415-1.363-.465-2.428C2.01 15.056 2 14.717 2 12s.01-3.056.06-4.122c.05-1.065.217-1.79.465-2.428a4.9 4.9 0 011.153-1.771A4.9 4.9 0 015.45 2.525c.637-.248 1.363-.415 2.428-.465C8.944 2.01 9.283 2 12 2zm0 5a5 5 0 100 10 5 5 0 000-10zm0 8.25a3.25 3.25 0 110-6.5 3.25 3.25 0 010 6.5zM17.5 6.25a1 1 0 100 2 1 1 0 000-2z" },
  { url: footer?.facebookUrl, label: "Facebook", icon: "M22 12a10 10 0 10-11.56 9.87v-6.98H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.45h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.98A10 10 0 0022 12z" },
  { url: footer?.tiktokUrl, label: "TikTok", icon: "M16.6 5.82s.51.5 0 0A4.278 4.278 0 0115.54 3h-3.09v12.4a2.592 2.592 0 01-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 004.3 1.38V7.3s-1.88.09-3.24-1.48z" },
  { url: footer?.youtubeUrl, label: "YouTube", icon: "M23.5 6.2a3.02 3.02 0 00-2.12-2.14C19.51 3.55 12 3.55 12 3.55s-7.51 0-9.38.51A3.02 3.02 0 00.5 6.2 31.6 31.6 0 000 12a31.6 31.6 0 00.5 5.8 3.02 3.02 0 002.12 2.14c1.87.51 9.38.51 9.38.51s7.51 0 9.38-.51a3.02 3.02 0 002.12-2.14A31.6 31.6 0 0024 12a31.6 31.6 0 00-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z" },
].filter((s) => s.url);
---

<footer class="bg-neutral-dark text-neutral-white pt-14 mt-16">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-10">

    <div class="md:col-span-1">
      {footer?.footerLogo ? (
        <img src={footer.footerLogo} alt="Logo" class="h-14 mb-4" width="56" height="56" />
      ) : (
        <span class="font-heading font-bold text-xl">
          KKA <span class="text-secondary-text">Kediri</span>
        </span>
      )}
      <p class="text-sm text-neutral-white/60 mt-3 leading-relaxed">
        {footer?.footerText ?? "Kompetisi Kompetensi Akademik — Jawa Pos Radar Kediri. Challenge Your Brain, Test Your Skills."}
      </p>

      {socials.length > 0 && (
        <div class="mt-5">
          <p class="text-xs font-semibold text-neutral-white/50 uppercase tracking-wide mb-3">Ikuti Kami</p>
          <div class="flex gap-2">
            {socials.map((s) => (
              <a
                href={s.url!}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="w-9 h-9 rounded-full bg-neutral-white/10 flex items-center justify-center hover:bg-secondary hover:text-neutral-dark transition-colors"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon} /></svg>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <div>
      <h3 class="font-heading font-semibold mb-4 text-sm uppercase tracking-wide relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-secondary">
        Tautan
      </h3>
      <ul class="text-sm text-neutral-white/60 flex flex-col gap-2.5 mt-4">
        {menu.map((item) => {
          const href = item.linkType === "internal_page" ? `/${item.target}` : item.target;
          return (
            <li>
              <a href={href} class="hover:text-secondary transition-colors">{item.label}</a>
            </li>
          );
        })}
      </ul>
    </div>

    <div>
      <h3 class="font-heading font-semibold mb-4 text-sm uppercase tracking-wide relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-secondary">
        Bantuan
      </h3>
      <ul class="text-sm text-neutral-white/60 flex flex-col gap-2.5 mt-4">
        {bantuan.map((b) => (
          <li>
            <a href={b.href} class="hover:text-secondary transition-colors">{b.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-heading font-semibold mb-4 text-sm uppercase tracking-wide relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-secondary">
        Kontak
      </h3>
      <div class="flex flex-col gap-3 mt-4 text-sm text-neutral-white/60">
        {footer?.alamat && (
          <div class="flex items-start gap-2.5">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z" />
              <circle cx="12" cy="9.5" r="2.5" />
            </svg>
            <span>{footer.alamat}</span>
          </div>
        )}
        {footer?.whatsapp && (
          <div class="flex items-center gap-2.5">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="shrink-0 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`https://wa.me/${footer.whatsapp.replace(/\D/g, "")}`} class="hover:text-secondary transition-colors">{footer.whatsapp}</a>
          </div>
        )}
        {footer?.email && (
          <div class="flex items-center gap-2.5">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="shrink-0 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${footer.email}`} class="hover:text-secondary transition-colors">{footer.email}</a>
          </div>
        )}
        {footer?.jamOperasional && (
          <div class="flex items-start gap-2.5">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="whitespace-pre-line">{footer.jamOperasional}</span>
          </div>
        )}
      </div>
    </div>

  </div>

  <div class="max-w-6xl mx-auto px-6 mt-10 pt-6 border-t border-neutral-white/10 flex flex-col sm:flex-row justify-between items-center gap-3 pb-6 text-xs text-neutral-white/40">
    <p>© {currentYear} {footer?.copyright ?? "Kompetisi Kompetensi Akademik — Jawa Pos Radar Kediri"}</p>
    <div class="flex gap-4">
      <a href="/regulasi" class="hover:text-secondary transition-colors">Regulasi</a>
      <a href="/kontak" class="hover:text-secondary transition-colors">Kontak</a>
    </div>
  </div>
</footer>