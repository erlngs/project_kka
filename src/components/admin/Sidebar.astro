---
const currentPath = Astro.url.pathname;
const menuGroups = [
  {
    label: 'Menu',
    items: [
      { label: 'Dashboard', href: '/admin', icon: 'M4 6h16M4 12h16M4 18h7' },
    ],
  },
  {
    label: 'Tampilan Website',
    items: [
      { label: 'Navbar', href: '/admin/navbar', icon: 'M4 6h16M4 12h16M4 18h16' },
       { label: 'Footer', href: '/admin/footer', icon: 'M4 6h16M4 12h16M4 18h16' },
      { label: 'Halaman', href: '/admin/halaman', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
      { label: 'Testimoni', href: '/admin/testimoni', icon: 'M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l1.586-1.586z' },
      { label: 'Artikel', href: '/admin/artikel', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
    ],
  },
  {
    label: 'Kompetisi',
    items: [
      { label: 'Wilayah', href: '/admin/wilayah', icon: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z' },
      { label: 'Gelombang & Biaya', href: '/admin/gelombang', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
      { label: 'Pendaftaran', href: '/admin/pendaftaran', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
      { label: 'Pembayaran', href: '/admin/pembayaran', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
      { label: 'Kecamatan', href: '/admin/kecamatan', icon: 'M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z' },
    ],
  },
  {
    label: 'Sistem',
    items: [
      { label: 'Admin', href: '/admin/admin', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7zM20 8v6m3-3h-6' },
      { label: 'Pesan', href: '/admin/pesan', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7zM20 8v6m3-3h-6' },
    ],
  },
];
function isActive(href: string) {
  if (href === '/admin') return currentPath === '/admin';
  return currentPath.startsWith(href);
}
---
<div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/30 z-30 lg:hidden"></div>
<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-neutral-white border-r border-neutral-gray flex flex-col -translate-x-full lg:translate-x-0 transition-transform duration-200">
  <div class="px-6 py-5 flex items-center justify-between">
    <span class="font-heading font-bold text-lg text-neutral-dark">KKA <span class="text-secondary">Kediri</span></span>
    <button id="sidebar-close" class="lg:hidden text-neutral-dark/50">
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <nav class="flex-1 overflow-y-auto px-4 pb-4">
  {menuGroups.map((group) => (
    <div class="mb-6">
      <p class="px-2 text-[11px] font-semibold text-neutral-dark/40 uppercase tracking-wider mb-2">{group.label}</p>
      {group.items.map((item) => {
        const active = isActive(item.href);
        return (
          <a href={item.href} class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors mb-0.5 ${active ? 'bg-primary/10 text-primary' : 'text-neutral-dark/60 hover:bg-neutral-gray hover:text-neutral-dark'}`}>
            <svg class="w-4.5 h-4.5 shrink-0" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>
  ))}
  </nav>
  <div class="px-4 py-4 border-t border-neutral-gray">
    <form action="/api/auth/logout" method="post">
      <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-red-500 hover:bg-red-50 transition-colors">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Keluar</span>
      </button>
    </form>
  </div>
</aside>
<script>
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  document.getElementById('sidebar-open')?.addEventListener('click', () => { sidebar?.classList.remove('-translate-x-full'); overlay?.classList.remove('hidden'); });
  document.getElementById('sidebar-close')?.addEventListener('click', () => { sidebar?.classList.add('-translate-x-full'); overlay?.classList.add('hidden'); });
  overlay?.addEventListener('click', () => { sidebar?.classList.add('-translate-x-full'); overlay?.classList.add('hidden'); });
</script>