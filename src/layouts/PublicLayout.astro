---
import Navbar from "../components/public/Navbar.astro";
import Footer from "../components/public/Footer.astro";
import PendingInvoiceBanner from "../components/public/PendingInvoiceBanner.astro";
import "../styles/global.css";

interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | KKA Radar Kediri</title>
  </head>
  <body class="font-body text-neutral-dark">
    <PendingInvoiceBanner />
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>