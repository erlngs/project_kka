---
import Sidebar from "../components/admin/Sidebar.astro";
import Topbar from "../components/admin/Topbar.astro";
import "../styles/global.css";

interface Props { title: string; }
const { title } = Astro.props;
---
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Admin KKA Kediri</title>
  </head>
  <body class="bg-neutral-gray font-body">
    <Sidebar />
    <div class="lg:pl-64">
      <Topbar title={title} />
      <main class="p-6">
        <slot />
      </main>
    </div>
  </body>
</html>