datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ================== ENUMS ==================

enum LinkType {
  internal_page
  external_url
  anchor
}

enum BlockType {
  heading
  paragraph
  image
  gallery
  table
  testimonial
  cta_button
  hero
  cards        // <-- tambahkan ini
}

enum Jenjang {
  SD_MI
  SMP_MTS
  SMA_MA_SMK
}

enum Gender {
  L
  P
}

enum JenisPendaftaran {
  mandiri
  kolektif
}

enum StatusPendaftaran {
  pending
  menunggu_verifikasi
  lunas
  ditolak
  dibatalkan
}

enum StatusInvoice {
  menunggu_pembayaran
  menunggu_verifikasi
  terverifikasi
  ditolak
}

enum AdminRole {
  admin
  superadmin
}

// ================== CMS ==================

model NavMenu {
  id          String    @id @default(uuid())
  label       String
  linkType    LinkType  @map("link_type")
  target      String
  parentId    String?   @map("parent_id")
  parent      NavMenu?  @relation("NavMenuToSub", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavMenu[] @relation("NavMenuToSub")
  orderIndex  Int       @default(0) @map("order_index")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("nav_menu")
}

model Page {
  id              String       @id @default(uuid())
  slug            String       @unique
  title           String
  metaDescription String?      @map("meta_description")
  heroImageUrl    String?      @map("hero_image_url")
  heroSubtitle    String?      @map("hero_subtitle")
  isPublished     Boolean      @default(true) @map("is_published")
  blocks          PageBlock[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("pages")
}

model PageBlock {
  id         String    @id @default(uuid())
  pageId     String    @map("page_id")
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockType  BlockType @map("block_type")
  content    Json      @default("{}")
  orderIndex Int       @default(0) @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("page_blocks")
}

model Pesan {
  id        String   @id @default(uuid())
  nama      String
  email     String
  telepon   String?
  pesan     String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pesan")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Setting {
  id            String  @id @default(uuid())
  key           String  @unique

  footerText    String?
  footerLogo    String?
  whatsapp      String?
  email         String?
  copyright     String?

  alamat        String?
  jamOperasional String? @map("jam_operasional")

  instagramUrl  String? @map("instagram_url")
  facebookUrl   String? @map("facebook_url")
  tiktokUrl     String? @map("tiktok_url")
  youtubeUrl    String? @map("youtube_url")

  bankNama      String?  @map("bank_nama")
  bankNorek     String?  @map("bank_norek")
  bankAtasNama  String?  @map("bank_atas_nama")

  updatedAt     DateTime @updatedAt

  @@map("settings")
}

model Testimoni {
  id         String   @id @default(uuid())
  nama       String
  asal       String?  // sekolah / peran, misal "Siswa SDN 1 Kediri"
  pesan      String
  fotoUrl    String?  @map("foto_url")
  rating     Int?     @default(5)
  orderIndex Int      @default(0) @map("order_index")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("testimoni")
}

model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  category    String?
  author      String?
  thumbnail   String?
  content     String
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("articles")
}

// ================== MASTER DATA ==================

model Wilayah {
  id          String        @id @default(uuid())
  nama        String
  region      String?
  logoUrl     String?       @map("logo_url")
  deskripsi   String?
  orderIndex  Int           @default(0) @map("order_index")
  isActive    Boolean       @default(true) @map("is_active")

  kecamatan   Kecamatan[]
  pendaftaran Pendaftaran[]
  pendaftaranBatch PendaftaranBatch[]

  @@map("wilayah")
}

model Kecamatan {
  id          String        @id @default(uuid())
  wilayahId   String        @map("wilayah_id")
  wilayah     Wilayah       @relation(fields: [wilayahId], references: [id], onDelete: Cascade)
  nama        String
  sekolah     Sekolah[]
  pendaftaran Pendaftaran[]
  pendaftaranBatch PendaftaranBatch[]

  @@map("kecamatan")
}

model Sekolah {
  id          String        @id @default(uuid())
  kecamatanId String?       @map("kecamatan_id")
  kecamatan   Kecamatan?    @relation(fields: [kecamatanId], references: [id])
  nama        String
  jenjang     Jenjang?
  npsn        String?
  pendaftaran Pendaftaran[]

  @@map("sekolah")
}

model Gelombang {
  id             String              @id @default(uuid())
  nama           String
  tanggalMulai   DateTime            @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime            @map("tanggal_selesai") @db.Date
  isActive       Boolean             @default(true) @map("is_active")
  biaya          BiayaPendaftaran[]
  pendaftaran    Pendaftaran[]
  pendaftaranBatch PendaftaranBatch[]

  @@map("gelombang")
}

model BiayaPendaftaran {
  id          String    @id @default(uuid())
  gelombangId String    @map("gelombang_id")
  gelombang   Gelombang @relation(fields: [gelombangId], references: [id], onDelete: Cascade)
  jenjang     Jenjang
  harga       Decimal   @db.Decimal(12, 2)

  @@unique([gelombangId, jenjang])
  @@map("biaya_pendaftaran")
}

// ================== PENDAFTARAN ==================

model Pendaftaran {
  id               String            @id @default(uuid())
  namaSiswa        String            @map("nama_siswa")
  nisn             String
  noWhatsapp       String            @map("no_whatsapp")
  gender           Gender?
  wilayahId        String?           @map("wilayah_id")
  wilayah          Wilayah?          @relation(fields: [wilayahId], references: [id])
  kecamatanId      String?           @map("kecamatan_id")
  kecamatan        Kecamatan?        @relation(fields: [kecamatanId], references: [id])
  jenjang          Jenjang?
  kelas            String?
  sekolahId        String?           @map("sekolah_id")
  sekolah          Sekolah?          @relation(fields: [sekolahId], references: [id])
  sekolahManual    String?           @map("sekolah_manual")
  gelombangId      String?           @map("gelombang_id")
  gelombang        Gelombang?        @relation(fields: [gelombangId], references: [id])
  jenisPendaftaran JenisPendaftaran  @default(mandiri) @map("jenis_pendaftaran")
  status           StatusPendaftaran @default(pending)
  syncedToSheet    Boolean           @default(false) @map("synced_to_sheet")
  invoice          Invoice?
  createdAt        DateTime          @default(now()) @map("created_at")
  batchId       String?           @map("batch_id")
  batch         PendaftaranBatch? @relation(fields: [batchId], references: [id])

  @@index([status])
  @@index([syncedToSheet])
  @@map("pendaftaran")
}

model PendaftaranBatch {
  id              String        @id @default(uuid())
  namaKoordinator String        @map("nama_koordinator")
  namaSekolah     String        @map("nama_sekolah")
  noWhatsapp      String        @map("no_whatsapp")
  wilayahId       String?       @map("wilayah_id")
  wilayah         Wilayah?      @relation(fields: [wilayahId], references: [id])
  kecamatanId     String?       @map("kecamatan_id")
  kecamatan       Kecamatan?    @relation(fields: [kecamatanId], references: [id])
  gelombangId     String?       @map("gelombang_id")
  gelombang       Gelombang?    @relation(fields: [gelombangId], references: [id])
  pendaftaran     Pendaftaran[]
  invoice         Invoice?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("pendaftaran_batch")
}

// ================== PEMBAYARAN ==================

model Invoice {
  id                 String            @id @default(uuid())
  pendaftaranId      String?           @unique @map("pendaftaran_id")
  pendaftaran        Pendaftaran?      @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  batchId            String?           @unique @map("batch_id")
  batch              PendaftaranBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invoiceCode        String            @unique @map("invoice_code")
  jumlahTagihan      Decimal           @map("jumlah_tagihan") @db.Decimal(12, 2)
  metodePembayaran   String?           @map("metode_pembayaran")
  buktiPembayaranUrl String?           @map("bukti_pembayaran_url")
  catatanAdmin       String?           @map("catatan_admin")
  status             StatusInvoice     @default(menunggu_pembayaran)
  dikonfirmasiOleh   String?           @map("dikonfirmasi_oleh")
  admin              AdminUser?        @relation(fields: [dikonfirmasiOleh], references: [id])
  dikonfirmasiAt     DateTime?         @map("dikonfirmasi_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@map("invoices")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  nama         String?
  role         AdminRole @default(admin)
  invoices     Invoice[]

  @@map("admin_users")
}